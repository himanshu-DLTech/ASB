{
    "flow": {
        "name":"create daily mantis report which calculte the number of mantis open, number of notes added and number of PR raised by the user",
        "disabled": false,
        "expandRouteProperties": true
    },
    "listener": {
        "type": "timer",
        "isMessageGenerator": true,
        "cron": "0 20 1 * * *"
    },
    "route0" :{
        "type":"js",
        "dependencies" : "listener",
        "module":"{{{ESB_DIR}}}/custom/headerForResolvedMantis.js"
    },
    "route1":{
        "type" : "rest",
        "dependencies" : "route0",
        "url":"https://tekmonks.mantishub.io/api/rest/issues?page_size=50&page=1",
        "method":"get"
    },
    "route2":{
        "type":"js",
        "dependencies":"route1",
        "module":"{{{ESB_DIR}}}/custom/generateMantisReport.js"
    }
}