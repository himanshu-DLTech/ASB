{
    "flow": {
        "name":"Sever Password Change Reminder Fortnightly",
        "disabled": false,
        "autoGC":false,
        "expandRouteProperties": true,
        "cpuInterval": 15000
    },
    "listener": {
        "type": "timer",
        "isMessageGenerator": true,
        "cron": "0 0 10 1,16 * *"
    },
    "route0":{
        "type":"mustache",
        "dependencies":["listener"],
        "template":"{{{ESB_DIR}}}/custom/templates/serverPasswordReminder.html"
    },
    "route1":{
        "type" : "js",
        "dependencies": ["route0"],
        "module":"{{{ESB_DIR}}}/custom/emailServerPasswordReminder.js"    
    },
    "output":{
        "type":"email",
        "dependencies" : ["route1"],
		"host":"smtp.mailgun.org",
		"port": 465,
        "secure": true,
		"user": "postmaster@mg.monboss.com",
