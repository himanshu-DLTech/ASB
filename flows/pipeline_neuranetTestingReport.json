{
  "flow": {
    "name": "REST API for sending escalation mail",
    "disabled": true,
    "expandRouteProperties": true,
    "cpuInterval": 15000
  },
  "listener": {
    "type": "file",
    "isMessageGenerator": true,
    "path": "{{{ESB_DIR}}}/neuranetTest/*",
    "donePath": "{{{ESB_DIR}}}/processing"
  },  
  "route0":{
		"type": "js",
		"dependencies":["listener"],
		"isAsync": false,
		"module":"{{{ESB_DIR}}}/custom/csvToPng.js"
	},
  "route1":{
    "type": "js",
    "dependencies":["route0"],
    "isAsync": false,
    "module":"{{{ESB_DIR}}}/custom/neuranetTestReport.js"
  },
    "route2":{
        "type" : "rest",
        "dependencies" : ["route1"],
        "url":"https://tekmonks.mantishub.io/api/rest/issues/3823/notes",
        "method":"post"
    }
}
