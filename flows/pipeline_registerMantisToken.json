{
    "flow": {
        "name":"REST API for authenticate user and register mantis token ",
        "disabled": false,
        "autoGC":false,
        "expandRouteProperties": true,
        "cpuInterval": 15000
    },
    "listener": {
        "type":"rest_listener",
        "isMessageGenerator": true,
        "host": "167.71.230.49",
        "port": 9000,
        "url":"/registerUser",
        "allow_origin": "*",
        "timeout": 120000
    },
    "route0":{
        "type":"js",
        "dependencies" : "listener",
        "module":"{{{ESB_DIR}}}/custom/setEmailHeader.js"
    },
    "route1":{
        "type" : "rest",
        "dependencies" : "route0",
        "url":"https://tekmonks.mantishub.io/api/rest/users/me"
    },
    "route2":{
        "type":"js",
        "dependencies":[["route1"],["route1.error"]],
        "module":"{{{ESB_DIR}}}/custom/authenticateUsers.js"
    },
    "route3":{
        "type":"filereader",
        "dependencies":"route2",
        "path":"{{{ESB_DIR}}}/registerUser.json"
    },
    "route4":{
        "type":"js",
        "dependencies":"route3",
        "module":"{{{ESB_DIR}}}/custom/updateUsers.js"
    },
    "route5":{
        "type":"filewriter",
        "dependencies":"route4",
        "path":"{{{ESB_DIR}}}/registerUser.json"
    },
    "route6":{
        "type":"js",
        "dependencies":"route5",
        "module":"{{{ESB_DIR}}}/custom/setResponse.js"
    },
    "output":{
        "type":"rest_responder",
		"dependencies":[ "route6"]
    }
}