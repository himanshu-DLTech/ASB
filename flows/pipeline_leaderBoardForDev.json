{
    "flow": {
        "name":"weekly leaderBoard for devs and dba",
        "disabled": false,
        "autoGC":false,
        "expandRouteProperties": true,
        "cpuInterval": 15000
    },
    "listener": {
        "type": "timer",
        "isMessageGenerator": true,
        "cron": "0 0 3 * * 1"
    },
    "route0" :{
        "type":"js",
        "dependencies" : "listener",
        "module":"{{{ESB_DIR}}}/custom/leaderBoardForDev.js"
    },
    "route1":{
        "type":"mustache",
        "dependencies":["route0"],
        "template":"{{{ESB_DIR}}}/custom/templates/leaderBoard.html"
    },
    "route2":{
        "type" : "js",
        "dependencies": ["route1"],
        "js" : "message.logsMsg = message.content; message.content = {}; message.content.html = message.logsMsg; delete message.logsMsg; message.content.title = `WEEKLY LEADERBOARD - ${message.env.weekRange}` ; const utils = require(CONSTANTS.LIBDIR + '/utils.js');  let users = utils.getRegisterUsers();  message.content.to = Object.keys(users);"
    },
    "output":{
        "type":"email",
        "dependencies" : ["route2"],
		"host":"smtp.gmail.com",
		"port": 465,
		"secure": true,
		"user": "logbot@deeplogictech.com",
		"password": "jafh ocnx jbbx ksim",
		"from": "'Mantis Tracker'<logbot@deeplogictech.com>"
    }
}