{
    "flow": {
        "name":"report generation",
        "disabled": false,
        "autoGC":false,
        "expandRouteProperties": true,
        "cpuInterval": 15000
    },
    "listener": {
            "type":"timer", 
            "isMessageGenerator": true,
            "cron": "0 0 1 * * *"
    },
    "route0" :{
        "type":"js",
        "dependencies" : "listener",
        "module":"{{{ESB_DIR}}}/custom/mapping.js"
    },
    "route1":{
        "type" : "rest",
        "dependencies" : "route0",
        "url":"https://tekmonks.mantishub.io/api/rest/issues?page_size=150&page=1&select=id,summary,description,updated_at,history,created_at",
        "method":"get"
    },
    "route2":{
        "type":"js",
        "dependencies":"route1",
        "module":"{{{ESB_DIR}}}/custom/countActivity.js"
    },
    "route3":{
        "type":"js",
        "dependencies":"route1",
        "module":"{{{ESB_DIR}}}/custom/reportGenerate.js"
    }
}