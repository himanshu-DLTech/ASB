{
    "flow": {
        "name":"Product Update Reminder",
        "disabled": true,
        "autoGC":false,
        "expandRouteProperties": true,
        "cpuInterval": 15000
    },
    "listener": {
        "type": "timer",
        "isMessageGenerator": true,
        "cron": "0 30 8 * * 2"
        
    },
    "route0":{
        "type":"mustache",
        "dependencies":["listener"],
        "template":"{{{ESB_DIR}}}/custom/templates/productUpdate.html"
    },
    "route1":{
        "type" : "js",
        "dependencies": ["route0"],
        "js" : "message.logsMsg = message.content; message.content = {}; message.content.html = message.logsMsg; delete message.logsMsg ;"
    },
    "output":{
        "type":"email",
        "dependencies" : ["route1"],
		"host":"smtp.gmail.com",
		"port": 465,
        "title":"🔔 Product Update - Reminder",
        "to":"ankit.saxena@deeplogictech.com",
		"secure": true,
		"user": "logbot@deeplogictech.com",
		"password": "jafh ocnx jbbx ksim",
		"from": "'Reminder'<watchman@mg.monbosss.com>"
    }
}