{
    "flow": {
        "name":"Manager Monthly Updates Reminder",
        "disabled": true,
        "autoGC":false,
        "expandRouteProperties": true,
        "cpuInterval": 15000
    },
    "listener": {
        "type":"rest_listener",
        "isMessageGenerator": true,
        "host": "127.0.0.1",
        "port":9000,
        "url":"/pdcall",
        "allow_origin": "*",
        "timeout": 120000
    },
    "route0":{
        "type":"mustache",
        "dependencies":["listener"],
        "template":"{{{ESB_DIR}}}/custom/templates/managerMonthlyReminder.html"
    },
    "route1":{
        "type" : "js",
        "dependencies": ["route0"],
        "js" : "message.logsMsg = message.content; message.content = {}; message.content.html = message.logsMsg; delete message.logsMsg ;"
    },
    "output":{
        "type":"email",
        "dependencies" : ["route1"],
		"host":"smtp.gmail.com",
		"port": 465,
        "title":"🔔 Monthly Updates Reminder",
        "to":"ankit.saxena@deeplogictech.com",
		"secure": true,
		"user": "logbot@deeplogictech.com",
		"password": "jafh ocnx jbbx ksim",
		"from": "'Reminder'<watchman@mg.monbosss.com>"
    },
    "output1":{
        "type":"rest_responder",
		"dependencies":[ "output"]
    }
}