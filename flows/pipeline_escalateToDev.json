{
    "flow": {
      "name": "Escalation mail to Dev's",
      "disabled": true,
      "expandRouteProperties": true,
      "cpuInterval": 15000
    },
    "listener": {
        "type": "timer",
        "isMessageGenerator": true,
        "cron": "0 0 4 * * 2-6"
    },
    "route0":{
          "type": "js",
          "dependencies":["listener"],
          "module":"{{{ESB_DIR}}}/custom/escalateToDev.js"
      },
      "route1":{
          "type": "js",
          "dependencies":["route0"],
          "module":"{{{ESB_DIR}}}/custom/getEscalationEmails.js"
      }
}
