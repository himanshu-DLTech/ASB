{
    "flow": {
        "name":"Manager Leaderboard Appreciation Reminder",
        "disabled": true,
        "autoGC":false,
        "expandRouteProperties": true,
        "cpuInterval": 15000
    },
    "listener": {
        "type": "timer",
        "isMessageGenerator": true,
        "cron": "0 0 6 1,2,3 * *"
    },
    "route0":{
        "type":"mustache",
        "dependencies":["listener"],
        "template":"{{{ESB_DIR}}}/custom/templates/managerLeaderBoardReminder.html"
    },
    "route1":{
        "type" : "js",
        "dependencies": ["route0"],
        "js" : "message.logsMsg = message.content; message.content = {}; message.content.html = message.logsMsg; delete message.logsMsg;"
    },
    "output":{
        "type":"email",
        "dependencies" : ["route1"],
