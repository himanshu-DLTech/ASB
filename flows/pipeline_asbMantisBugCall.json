{
    "flow":{
		"name":"Call Mantis BUG Flow",
		"disabled":true,
		"expandRouteProperties": true
	},
	"listener": {
		"type":"file", 
		"isMessageGenerator": true,
		"path":"{{{ESB_DIR}}}/asbTest/*"
	}, 
	"route0" :{
        "type":"js",
        "dependencies" : "listener",
        "module":"{{{ESB_DIR}}}/custom/headerForResolvedMantis.js"
    },
    "route1":{
        "type" : "rest",
        "dependencies" : "route0",
        "url":"https://tekmonks.mantishub.io/api/rest/issues?page_size={{{DEFAULT_PAGE_SIZE}}}&page={{{DEFAULT_PAGES}}}&project_id={{{ASB_USER_ID}}}",
        "method":"get"
    },
	"route2":{
		"type": "js",
		"dependencies":["route1"],
		"isAsync": false,
		"module":"{{{ESB_DIR}}}/custom/countFailedCases.js"
	}
}